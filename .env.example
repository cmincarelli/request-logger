# Chrome DevTools Protocol endpoint to attach to.
# `scripts/chrome-debug.sh` starts Chrome with --remote-debugging-port=9222.
CDP_HOST=127.0.0.1
CDP_PORT=9222

# Where session JSONL logs are written. One file per session.
LOG_DIR=./logs

# Reader UI + API server.
READER_HOST=127.0.0.1
READER_PORT=3001

# Optional: label this session (used in the log filename + manifest).
SESSION_LABEL=

# Max body size to capture per request/response, in bytes. Larger bodies are
# truncated and flagged truncated:true. Set 0 to capture full bodies.
MAX_BODY_BYTES=262144
